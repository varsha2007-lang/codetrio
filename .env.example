# Choose: none (safe default), openai_compatible, or transformers
MODEL_PROVIDER=none
MODEL_NAME=Qwen/Qwen2.5-3B-Instruct
# OpenAI-compatible local open-weight server, for example vLLM or llama.cpp server
MODEL_BASE_URL=http://localhost:8000/v1
# Keep credentials backend-only; do not put this in frontend variables.
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=15
# Optional for transformers provider: cpu, 0, etc.
MODEL_DEVICE=cpu
